# Gmail delivery (create an App Password at https://myaccount.google.com/apppasswords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
GMAIL_TO=you@gmail.com

# Discord delivery (Server Settings -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token

# Optional: Free Gemini API key for AI bullet summaries (https://aistudio.google.com/apikey)
# If omitted, ZeroScroll uses its built-in offline extractive summarizer.
GEMINI_API_KEY=

# Optional: Secret iCal (.ics) feed URL from Google Calendar or Apple Calendar
ICAL_URL=
